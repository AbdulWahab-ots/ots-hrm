# ============================================================================
# OTS HRM backend — environment variables
# Copy to `.env` for local dev; on Railway set these in the service Variables tab.
# (The app reads the DB_* / TOKEN_SECRET_KEY names below — older JWT_SECRET etc.
#  are NOT used.)
# ============================================================================

# ---- Runtime ----
# Railway injects PORT automatically — do NOT set it there. 8060 is the local default.
PORT=8060
# 'local' disables SSL + auto-syncs the schema. Use 'production' on Railway.
NODE_ENV=production

# ---- Database (Postgres) ----
# On Railway: add a Postgres plugin, then reference its vars (Variables → New Variable →
# Add Reference), e.g.:
#   DB_Server=${{Postgres.PGHOST}}
#   DB_Port=${{Postgres.PGPORT}}
#   DB_userId=${{Postgres.PGUSER}}
#   DB_Password=${{Postgres.PGPASSWORD}}
#   DB_DataBase=${{Postgres.PGDATABASE}}
DB_Server=localhost
DB_Port=5432
DB_userId=hrm
DB_Password=change_me
DB_DataBase=hrm_local
# 'true' on a FRESH database so the schema is created from the entities on first
# boot (committed migrations are incremental-only). Turn OFF once the schema exists.
DB_SYNCHRONIZE=true

# ---- Auth (REQUIRED — the server fails closed without a JWT secret) ----
TOKEN_SECRET_KEY=generate_a_long_random_string
INVITE_TOKEN_SECRET_KEY=generate_another_long_random_string

# ---- CORS (REQUIRED for the Vercel frontend to call the API) ----
# Comma-separated allowlist of frontend origins (no trailing slash).
CORS_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Bootstrap seeder (used once via `npm run seed:bootstrap`) ----
SUPER_ADMIN_EMAIL=superadmin@hrm.com
SUPER_ADMIN_PASSWORD=ChangeMe_Strong#123
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=ChangeMe_Strong#123

# ---- Email (optional — invites / notifications via SendGrid SMTP) ----
SENDGRID_HOST=smtp.sendgrid.net
SENDGRID_PORT=587
SENDGRID_SECURE=false
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
EMAIL_FROM_NAME=OTS HRM
SUPPORT_EMAIL=support@yourdomain.com

# ---- File storage (optional — profile images; pick ONE provider) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hrm
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# ---- Misc ----
# 'false' disables the attendance cron jobs (daily record + absent marking).
ATTENDANCE_CRON_ENABLED=true
